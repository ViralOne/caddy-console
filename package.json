{
  "name": "caddy-console",
  "version": "0.6.0",
  "description": "Web UI to edit your Caddyfile. Google OAuth, backup/restore with diff, validate before save.",
  "main": "index.js",
  "scripts": {
    "build": "npm run build:editor && npm run build:vendor",
    "build:editor": "esbuild src/static/js/editor-src.js --bundle --format=iife --outfile=src/static/js/editor.bundle.js --minify",
    "build:vendor": "esbuild src/static/js/explore-vendor-src.js --bundle --format=esm --outfile=src/static/js/explore-vendor.js --minify"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ViralOne/caddy-console.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "//type": "ESM so Node can import the browser modules under src/static/js/app directly in tests; nothing here is CommonJS.",
  "type": "module",
  "bugs": {
    "url": "https://github.com/ViralOne/caddy-console/issues"
  },
  "homepage": "https://github.com/ViralOne/caddy-console#readme",
  "devDependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.4",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.11",
    "codemirror": "^6.0.2",
    "esbuild": "^0.28.2",
    "htm": "^3.1.1",
    "preact": "^10.29.8"
  }
}
