# Auth mode: "google" or "cloudflare"
AUTH_MODE=google

# --- Google OAuth (only needed if AUTH_MODE=google) ---
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# --- Cloudflare Access (only needed if AUTH_MODE=cloudflare) ---
# Cloudflare Zero Trust -> Networks -> Tunnels -> your tunnel token
CLOUDFLARE_TUNNEL_TOKEN=your-tunnel-token-here

# Verify the Cloudflare Access JWT instead of trusting a header. Strongly
# recommended: without these, anything that can reach the editor's port can
# impersonate any user by setting one header.
#   Team domain: Zero Trust -> Settings -> Custom Pages (e.g. myteam.cloudflareaccess.com)
#   AUD tag:     Zero Trust -> Access -> Applications -> your app -> Application settings (tab) -> AUD tag
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# Restrict to your domain (e.g. yourcompany.com) — works with both auth modes
ALLOWED_DOMAIN=yourcompany.com

# Optional: restrict to specific emails (comma-separated), leave empty for domain-only check
ALLOWED_EMAILS=

# Flask secret key (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-me-to-a-random-string

# Caddyfile path (docker mounts test-Caddyfile to /etc/caddy/Caddyfile)
CADDYFILE_PATH=/etc/caddy/Caddyfile

# Caddy API URL (the caddy server container for reload)
CADDY_API_URL=http://caddy:2019

# Backup directory
BACKUP_DIR=/backups

# How many pre-save backups to keep (oldest pruned after each save; 0 = keep all)
BACKUP_KEEP=50

# Rotate the audit log past this size (bytes); one rotated file is kept
AUDIT_LOG_MAX_BYTES=5242880

# Caddy access log file (must match the path in your Caddyfile's log directive)
CADDY_LOG_FILE=/var/log/caddy/access.log

# How far back into the access log the dashboard and explorer scan, in MB. The
# UI can pick 10/25/50/100 per session; this is only the starting value. Keep it
# at or below your Caddyfile roll_size, since only the current (unrolled) file is
# read. Max 100.
CADDY_EXPLORE_WINDOW_MB=10

# Events the explorer holds in memory from that window. Columnar storage costs
# ~38 bytes per event retained, and building the index from a 100 MB log peaks
# around 55 MB and takes ~5s. A 100 MB window is roughly 277k events, so the
# default cap drops the oldest ~28% of it (reported in the UI, not hidden). The
# 10 MB default window is ~28k events and nowhere near the cap.
CADDY_EXPLORE_MAX_EVENTS=200000
