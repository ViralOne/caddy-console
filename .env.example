# Immutable console image reference used by non-development Compose stacks.
# After CI publishes a commit, use its sha-<commit> tag or, preferably, digest.
CADDY_CONSOLE_IMAGE=ghcr.io/viralone/caddy-console:sha-REPLACE_WITH_COMMIT

# Auth mode: "google" or "cloudflare"
AUTH_MODE=google

# --- Google OAuth (only needed if AUTH_MODE=google) ---
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
# Public HTTPS origin used to build the Google callback URL. Required in Google
# mode outside local development and must exactly match the authorized redirect.
SERVER_URL=https://caddy-console.example.com
SESSION_TIMEOUT_HOURS=8
SESSION_COOKIE_SECURE=true

# --- Cloudflare Tunnel transport (production stack, both auth modes) ---
# Cloudflare Zero Trust -> Networks -> Tunnels -> your tunnel token
CLOUDFLARE_TUNNEL_TOKEN=your-tunnel-token-here

# --- Cloudflare Access authentication (AUTH_MODE=cloudflare) ---
# Cloudflare Access verification is mandatory in cloudflare mode. The app
# refuses to start unless both values are set. Only the dev Compose stack opts
# into its synthetic unsigned header explicitly; the internal and production
# stacks do not pass that escape hatch.
#   Team domain: Zero Trust -> Settings -> Custom Pages (e.g. myteam.cloudflareaccess.com)
#   AUD tag:     Zero Trust -> Access -> Applications -> your app -> Application settings (tab) -> AUD tag
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# Restrict to your domain (e.g. yourcompany.com) — works with both auth modes
ALLOWED_DOMAIN=yourcompany.com

# Optional: restrict to specific emails (comma-separated), leave empty for domain-only check
ALLOWED_EMAILS=

# Flask secret key (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-me-to-a-random-string

# Caddyfile path (Compose mounts its containing directory at /etc/caddy)
CADDYFILE_PATH=/etc/caddy/Caddyfile

# Caddy API URL (the caddy server container for reload)
CADDY_API_URL=http://caddy:2019

# Backup directory
BACKUP_DIR=/backups

# How many pre-save backups to keep (oldest pruned after each save; 0 = keep all)
BACKUP_KEEP=50

# Rotate the audit log past this size (bytes); one rotated file is kept
AUDIT_LOG_MAX_BYTES=5242880

# Caddy access log file (must match the path in your Caddyfile's log directive)
CADDY_LOG_FILE=/var/log/caddy/access.log

# Events the explorer holds in memory for the selected time range. Columnar storage costs
# ~38 bytes per event retained. The default 30-minute view is a few thousand
# events; a 30-day range across rolled archives is what can reach this cap, and
# when it does the oldest are dropped and the UI says so. How far back you can
# look at all is set by roll_keep / roll_keep_for in your Caddyfile, not here.
CADDY_EXPLORE_MAX_EVENTS=200000
